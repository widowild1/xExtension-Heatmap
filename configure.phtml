<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

    <div class="form-group">
        <label class="group-name" for="searxng_url">URL de l'instance SearXNG</label>
        <div class="group-controls">
            <input type="url" 
                   id="searxng_url" 
                   name="searxng_url" 
                   value="<?php echo htmlspecialchars(FreshRSS_Context::$user_conf->heatmap_searxng_url ?? '', ENT_QUOTES, 'UTF-8'); ?>" 
                   placeholder="http://192.168.1.50:8080 ou https://searxng.example.com" 
                   style="width: 100%; max-width: 450px;" />
            <p class="help">Laissez vide pour désactiver les requêtes vers SearXNG.</p>
        </div>
    </div>

    <div class="form-group form-actions">
        <div class="group-controls">
            <button type="submit" class="btn btn-important">Enregistrer</button>
        </div>
    </div>
</form>
