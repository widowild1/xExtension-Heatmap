<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

    <div class="form-group">
        <label class="group-name" for="searxng_url">URL de SearXNG</label>
        <div class="group-controls">
            <input type="url" 
                   id="searxng_url" 
                   name="searxng_url" 
                   value="<?php echo htmlspecialchars(FreshRSS_Context::$user_conf->heatmap_searxng_url ?? '', ENT_QUOTES, 'UTF-8'); ?>" 
                   placeholder="http://192.168.1.50:8080 ou https://searxng.example.com" 
                   style="width: 100%; max-width: 480px;" />
            <p class="help">L'adresse de votre instance locale ou publique. Assurez-vous que le format JSON est actif dans settings.yml.</p>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name">Sources de popularité actives</label>
        <div class="group-controls">
            <label class="checkbox" style="display: block; margin-bottom: 8px;">
                <input type="checkbox" name="enable_searxng" value="1" <?php echo (FreshRSS_Context::$user_conf->heatmap_enable_searxng ?? true) ? 'checked="checked"' : ''; ?> />
                Activer la recherche via <strong>SearXNG</strong> (citations web)
            </label>
            <label class="checkbox" style="display: block; margin-bottom: 8px;">
                <input type="checkbox" name="enable_hn" value="1" <?php echo (FreshRSS_Context::$user_conf->heatmap_enable_hn ?? true) ? 'checked="checked"' : ''; ?> />
                Activer <strong>Hacker News</strong> (Algolia API)
            </label>
            <label class="checkbox" style="display: block; margin-bottom: 8px;">
                <input type="checkbox" name="enable_reddit" value="1" <?php echo (FreshRSS_Context::$user_conf->heatmap_enable_reddit ?? true) ? 'checked="checked"' : ''; ?> />
                Activer <strong>Reddit</strong> (API publique)
            </label>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="timeout">Délai d'attente réseau (secondes)</label>
        <div class="group-controls">
            <input type="number" 
                   id="timeout" 
                   name="timeout" 
                   min="1" 
                   max="10" 
                   value="<?php echo intval(FreshRSS_Context::$user_conf->heatmap_timeout ?? 3); ?>" 
                   style="width: 80px;" />
            <p class="help">Délai maximal par requête externe (défaut : 3s). Une valeur basse évite de ralentir le serveur.</p>
        </div>
    </div>

    <div class="form-group form-actions">
        <div class="group-controls">
            <button type="submit" class="btn btn-important">Enregistrer les paramètres</button>
        </div>
    </div>
</form>
